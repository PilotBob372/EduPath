# Скопируйте этот файл в deploy/.env и заполните значения

# База данных PostgreSQL (пароль для пользователя edupath)
DB_PASSWORD=придумайте_надёжный_пароль

# Anthropic API (тот же ключ, что используется в Replit)
ANTHROPIC_API_KEY=sk-...
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.proxyapi.ru/anthropic

# Секрет для сессий (любая случайная строка, минимум 32 символа)
SESSION_SECRET=случайная_строка_минимум_32_символа

# Email для SSL-сертификата Let's Encrypt
CERTBOT_EMAIL=ваш@email.com
