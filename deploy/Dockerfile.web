# ── Stage 1: Build frontend ────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app
COPY . .

RUN pnpm install --frozen-lockfile

# Build the Vite app; BASE_PATH=/ and a dummy PORT for the build step
RUN PORT=3000 BASE_PATH=/ NODE_ENV=production \
    pnpm --filter @workspace/edu-consultant run build

# ── Stage 2: nginx serving static files + reverse proxy ───────────────────
FROM nginx:1.27-alpine

# Static files baked into the image
COPY --from=builder /app/artifacts/edu-consultant/dist/public /usr/share/nginx/html

# Config will be mounted at runtime (see docker-compose.yml)
EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
